# Copy this file to .env and fill in your own values. .env is gitignored —
# never commit real credentials.

# Gmail credentials are NOT set here — each user logs into the app with
# their own Gmail address + App Password (kept only in their browser
# session, never written to disk).

# Optional — enables AI-based date extraction from the PA's reply, and
# AI-based agenda-item extraction from attendee replies (OpenAI).
# Leave blank to use the regex fallback instead (still works, just less flexible).
OPENAI_API_KEY=

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
IMAP_SERVER=imap.gmail.com

# false = safe test mode, nothing actually sends (just logged).
# true = real emails go out. Flip this only after testing.
LIVE_MODE=false

# How often run_agent_loop.py checks for work, in seconds. 1800 = 30 minutes.
CHECK_INTERVAL_SECONDS=1800

# Optional — gates the whole app behind one shared password, checked before
# the Gmail login screen even renders. Leave blank to leave the app open.
APP_ACCESS_PASSWORD=

# Optional — gates the MeetingMaster Admin tab behind a password.
# Leave blank to leave that tab unprotected.
ADMIN_PASSWORD=
